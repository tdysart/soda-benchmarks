"""torchscript.py — generated by sb-cli for $benchmark_name

Generates output/01_tosa.mlir from the $benchmark_name kernel, and — with
--emit-testdata — the C header the cpu/esp backends' test driver is built from.
Dataset: $dataset, Dtype: $dtype

Usage:
    python torchscript.py                          # write output/01_tosa.mlir
    python torchscript.py --emit-testdata out.h    # write the test data header
"""

import argparse
import os

import torch

from $kernel_module import $kernel_class, init_array
from $utils_module import (
    generate_mlir,
    get_dataset_dimensions,
    resolve_dtype,
)

OUT_PATH = "./output/01_tosa.mlir"

# C type per --dtype. float16 has no portable C spelling, and the kernel is
# compiled as-is rather than through a half-float library, so it is rejected
# rather than silently widened.
_C_TYPES = {"float32": "float", "float64": "double"}

# Comparison tolerance baked into the header, per element type.
_C_TOLERANCE = {"float32": "1e-3", "float64": "1e-9"}


def _c_array(values, per_line: int = 8) -> str:
    """Format a flat float sequence as the body of a C initializer list."""
    items = [f"{v!r}" for v in values]
    chunks = [items[i : i + per_line] for i in range(0, len(items), per_line)]
    # A trailing comma on the last line too, so the chunks are independent.
    return "\n".join("    " + ", ".join(chunk) + "," for chunk in chunks)


def emit_testdata(path: str, arg_order: list[int] | None = None) -> None:
    """Write a C header holding this kernel's inputs and the PyTorch golden results.

    The header carries everything that varies per kernel — how many parameters
    `forward_kernel` takes, in what order, and how big each one is — so that the
    driver that includes it (scripts/lib/soda_testbench_main.c) stays generic.
    That is why TD_CALL is a macro: the arity is not knowable in C.

    Every parameter is emitted as an array, rank-0 scalars included, because the
    bare-pointer memref convention the kernel is lowered with passes each memref
    as exactly one pointer.

    A kernel may return several tensors (bicg and mvt return two): each gets a
    destination buffer, after the inputs in @forward's signature, and a golden
    array. With one result the header has the names it always had (td_out,
    td_golden, TD_OUT, TD_OUT_N); with more they are numbered (td_out0,
    td_golden0, TD_OUT_N0, ...) and there is no TD_OUT. Either way TD_NOUT is the
    number of results and TD_OUTPUTS(X) expands X(buffer, golden, count) once per
    result, in order, which is how the driver walks them.

    Args:
        path: Where to write the header.
        arg_order: Indices into `@forward`'s parameter list (the inputs, then one
            destination buffer per result), in the order the *outlined*
            `forward_kernel` takes them — `scripts/kernel_arg_order.sh` produces
            it. `-soda-outline-bambu-code` orders parameters by first use rather
            than by signature, so for gemm this is `[3, 4, 0, 1, 2, 5]` and
            calling in signature order silently computes the wrong thing.
            Defaults to the identity.
    """
    dtype_name = "$dtype"
    if dtype_name not in _C_TYPES:
        raise SystemExit(
            f"--emit-testdata does not support --dtype {dtype_name}; "
            f"choose from {sorted(_C_TYPES)}"
        )

    dims = get_dataset_dimensions("$kernel_name", "$dataset")
    dtype = resolve_dtype(dtype_name)
    model = $kernel_class(**dims)
    inputs = init_array(**dims, dtype=dtype)
    with torch.no_grad():
        golden = model(*inputs)

    goldens = list(golden) if isinstance(golden, tuple) else [golden]

    ctype = _C_TYPES[dtype_name]
    n_out = len(goldens)

    # @forward takes the inputs first and the destination buffers last, which is
    # what bufferization leaves behind, so index len(inputs) + k is result k.
    n_in = len(inputs)
    if arg_order is None:
        arg_order = list(range(n_in + n_out))
    if sorted(arg_order) != list(range(n_in + n_out)):
        raise SystemExit(
            f"--arg-order must be a permutation of 0..{n_in + n_out - 1} "
            f"({n_in} inputs and {n_out} results), got {arg_order}"
        )

    def shape(tensor):
        return "x".join(str(d) for d in tensor.shape) or "scalar"

    parts = [
        "/* testdata.h — generated by torchscript.py --emit-testdata.",
        " *",
        " * Kernel: $kernel_name   Dataset: $dataset   Dtype: " + dtype_name,
        " * Consumed by scripts/lib/soda_testbench_main.c.",
        " */",
        "#ifndef SODA_TESTDATA_H",
        "#define SODA_TESTDATA_H",
        "",
        '#define TD_KERNEL  "$kernel_name"',
        '#define TD_DATASET "$dataset"',
        '#define TD_DTYPE   "' + dtype_name + '"',
        f"#define TD_TOL     {_C_TOLERANCE[dtype_name]}",
        "",
        f"typedef {ctype} td_elem_t;",
        "",
    ]

    names = []
    for i, tensor in enumerate(inputs):
        flat = tensor.reshape(-1).tolist()
        name = f"td_p{i}"
        names.append(name)
        parts.append(f"/* parameter {i}: shape {shape(tensor)} */")
        parts.append(f"static td_elem_t {name}[{len(flat)}] = {{")
        parts.append(_c_array(flat))
        parts.append("};")
        parts.append("")

    # One result keeps the names the header has always had; several are numbered.
    out_names, golden_names, count_names = [], [], []
    for k, g in enumerate(goldens):
        suffix = "" if n_out == 1 else str(k)
        out_names.append(f"td_out{suffix}")
        golden_names.append(f"td_golden{suffix}")
        count_names.append(f"TD_OUT_N{suffix}")
        parts += [
            f"/* result{'' if n_out == 1 else ' ' + str(k)}: shape {shape(g)} */",
            f"static td_elem_t {out_names[-1]}[{g.numel()}];",
            "",
            f"static const td_elem_t {golden_names[-1]}[{g.numel()}] = {{",
            _c_array(g.reshape(-1).tolist()),
            "};",
            "",
        ]
    if n_out == 1:
        parts += ["#define TD_OUT     td_out"]
    parts += [f"#define {count_names[k]} {goldens[k].numel()}" for k in range(n_out)]
    parts += [
        f"#define TD_NOUT    {n_out}",
        "/* TD_OUTPUTS(X): X(buffer, golden, count) for each result, in order */",
        "#define TD_OUTPUTS(X) "
        + " ".join(f"X({out_names[k]}, {golden_names[k]}, {count_names[k]})" for k in range(n_out)),
        "",
    ]
    call_names = names + out_names  # @forward's parameters: the inputs, then the result buffers
    parts += [
        "/* forward_kernel's parameter order, which -soda-outline-bambu-code",
        f" * derived by first use: {arg_order} into @forward's signature. */",
        "#define TD_CALL(F) F(" + ", ".join(call_names[i] for i in arg_order) + ")",
        # A real prototype rather than an empty parameter list: C2x removed those,
        # and the arity is only known here.
        "#define TD_DECL(F) void F(" + ", ".join(["td_elem_t *"] * len(arg_order)) + ")",
        "",
        "#endif /* SODA_TESTDATA_H */",
        "",
    ]

    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    with open(path, "w", encoding="utf-8") as handle:
        handle.write("\n".join(parts))
    print(f"Test data written to {path}")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--emit-testdata",
        metavar="PATH",
        default=None,
        help="Write the cpu/esp test data C header instead of the TOSA MLIR",
    )
    parser.add_argument(
        "--arg-order",
        metavar="INDICES",
        default=None,
        help=(
            "forward_kernel's parameter order as indices into @forward's "
            "signature, e.g. '3 4 0 1 2 5'; see scripts/kernel_arg_order.sh"
        ),
    )
    # parse_known_args, not parse_args: the Makefile's TOSA rule calls this script
    # with the output path and --dialect=tosa, which predate this parser and are
    # ignored here (OUT_PATH and the dialect are baked in by sb-cli).
    args, _ = parser.parse_known_args()

    if args.emit_testdata:
        order = None
        if args.arg_order:
            order = [int(tok) for tok in args.arg_order.replace(",", " ").split()]
        emit_testdata(args.emit_testdata, order)
        return

    dims = get_dataset_dimensions("$kernel_name", "$dataset")
    dtype = resolve_dtype("$dtype")
    model = $kernel_class(**dims)
    inputs = init_array(**dims, dtype=dtype)
    os.makedirs(os.path.dirname(OUT_PATH), exist_ok=True)
    generate_mlir(model, inputs, OUT_PATH, dialect="tosa")


if __name__ == "__main__":
    main()
